{
	"name": "shipshape",
	"version": "0.1.0",
	"private": true,
	"description": "One-shot code review CLI built on the Pi coding-agent SDK",
	"license": "MIT",
	"type": "module",
	"bin": {
		"shipshape": "dist/cli/main.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest --run",
		"shipshape": "npm run build --silent && node dist/cli/main.js",
		"build:binary": "bun scripts/build-binary.ts"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"ignore": "7.0.8",
		"minimatch": "10.2.6",
		"smol-toml": "1.9.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@types/node": "22.20.4",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	}
}
